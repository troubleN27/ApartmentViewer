# Скопируйте этот файл в .env и заполните значения. Сам .env в git не попадает (.gitignore).
# Без DATABASE_URL сервер работает на JSON-файлах из data/.

# Строка подключения к базе Neon: Dashboard → Connection string, вариант Pooled.
# Нужна для `npm run db:seed` и для локального запуска с базой. Вместо неё можно задать POSTGRES_URL.
DATABASE_URL=
